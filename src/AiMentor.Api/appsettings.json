{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "Provider": "Local"
  },
  "Workflow": {
    "Provider": "InMemory",
    "MaximumPendingRuns": 10000,
    "InitializeSchema": true
  },
  "Api": {
    "QuestionRateLimitPerMinute": 60,
    "EnableLegacyV0": false
  },
  "Authentication": {
    "Mode": "Development",
    "Authority": "",
    "Audience": "",
    "SubjectClaim": "sub",
    "TenantClaim": "tenant_id",
    "GroupsClaim": "groups",
    "Development": {
      "TenantId": "demo-beichen",
      "SubjectId": "development-user",
      "Groups": [ "all-rnd" ]
    }
  },
  "OpenSearch": {
    "Endpoint": "http://127.0.0.1:9200",
    "IndexName": "aimentor-knowledge-v1",
    "SearchPipelineName": "aimentor-hybrid-v1",
    "SynchronizeOnStartup": true
  }
}
