{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Rag": {
    "Provider": "Local"
  },
  "Model": {
    "Provider": "Deterministic",
    "TimeoutSeconds": 30,
    "MaximumRetries": 2
  },
  "Embedding": {
    "Provider": "Deterministic",
    "Dimensions": 256,
    "IndexVersion": "aimentor-knowledge-v1",
    "TimeoutSeconds": 30,
    "MaximumRetries": 2
  },
  "Reranker": {
    "Provider": "Lexical",
    "TimeoutSeconds": 30,
    "MaximumRetries": 2
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  },
  "Memory": {
    "MaximumPendingProposalsPerTenant": 10000,
    "RetentionCleanupIntervalMinutes": 15,
    "RetentionCleanupBatchSize": 1000,
    "Encryption": {
      "ActiveKeyVersion": "v1",
      "Keys": {},
      "FingerprintKey": ""
    }
  },
  "Workflow": {
    "Provider": "InMemory",
    "MaximumPendingRuns": 10000,
    "InitializeSchema": true,
    "Encryption": {
      "ActiveKeyVersion": "v1",
      "Keys": {}
    }
  },
  "Operations": {
    "ReviewerGroups": [ "tool-approvers" ],
    "EscalatorGroups": [ "operations-escalators" ],
    "ReviewLifetimeSeconds": 900,
    "MaximumPendingActions": 10000,
    "MaximumAuditEntriesPerTenant": 100000,
    "OutcomeUnknownRetentionDays": 30,
    "Web": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": [ "openid", "profile" ],
      "CallbackPath": "/signin-oidc",
      "SignedOutCallbackPath": "/signout-callback-oidc",
      "DataProtectionKeyPath": "",
      "DataProtectionClusterId": "",
      "DataProtectionKeyRingFingerprint": "",
      "DataProtectionCertificatePath": "",
      "DataProtectionDecryptionCertificatePaths": [],
      "DataProtectionCertificatePassword": "",
      "SessionLifetimeMinutes": 60,
      "DiscoveryTimeoutSeconds": 10
    }
  },
  "Agent": {
    "MaximumRunTimeSeconds": 10,
    "ResumeLeaseDurationSeconds": 30,
    "ResumeLeaseRenewalIntervalSeconds": 10
  },
  "Api": {
    "QuestionRateLimitPerMinute": 60,
    "EnableLegacyV0": false
  },
  "Authentication": {
    "Mode": "Development",
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true,
    "RefreshIntervalSeconds": 300,
    "SubjectClaim": "sub",
    "TenantClaim": "tenant_id",
    "GroupsClaim": "groups",
    "Development": {
      "TenantId": "demo-beichen",
      "SubjectId": "development-user",
      "Groups": [ "all-rnd" ]
    }
  },
  "OpenSearch": {
    "Endpoint": "http://127.0.0.1:9200",
    "IndexName": "aimentor-knowledge-v1",
    "SearchPipelineName": "aimentor-hybrid-v1",
    "VectorDimensions": 256,
    "SynchronizeOnStartup": true
  }
}
